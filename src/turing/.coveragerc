[run]
omit =
    */migrations/*
    *\migrations\*
    */tests.py
    *\tests.py
    */test_*.py
    *\test_*.py
    */*_tests.py
    *\*_tests.py
    manage.py
    */asgi.py
    *\asgi.py
    */wsgi.py
    *\wsgi.py

[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.
    def __repr__
    raise AssertionError
    raise NotImplementedError
